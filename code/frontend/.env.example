# ==============================================================================
# UberLite Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# - When running behind a reverse proxy (e.g. Nginx, Docker Compose, or single origin),
#   leave blank to use relative paths (/api).
# - When developing locally with Vite dev server proxying to port 5000, leave blank or set http://localhost:5000.
# - When deployed to cloud static hosting (Render Static, Vercel, Netlify),
#   set to the publicly accessible backend URL:
#   e.g., https://uberlite-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Optional Dev / Preview Server Port
PORT=5173
