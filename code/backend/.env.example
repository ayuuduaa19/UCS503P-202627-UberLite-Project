# ==============================================================================
# UberLite Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated origins, or '*' for unrestricted)
# For local development: http://localhost:5173
# For Docker Compose demo: http://localhost,http://localhost:80,http://localhost:5173
# For production cloud demo: https://your-frontend-domain.onrender.com
CORS_ORIGIN=http://localhost:5173,http://localhost,http://localhost:80

# PostgreSQL Database Connection String
# Local machine Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uberlite?schema=public"
# Docker Compose Postgres:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/uberlite?schema=public"
# Managed Cloud Postgres (e.g., Render / Supabase / Neon):
# DATABASE_URL="postgresql://user:password@hostname:5432/uberlite?sslmode=require"

# JWT Authentication Configuration
JWT_SECRET="uberlite-super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# Automated Database Initialization (used by Docker container entrypoint)
# Set to 'true' to automatically push Prisma schema and seed initial demo accounts
RUN_MIGRATIONS=true
RUN_SEED=true
