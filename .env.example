# ==============================================================================
# UberLite Root Deployment Environment Variables
# Used by docker-compose.yml and online deployment setups
# ==============================================================================

# PostgreSQL Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uberlite
POSTGRES_PORT=5432

# Backend Express Configuration
BACKEND_PORT=5000
NODE_ENV=production
JWT_SECRET=uberlite-demo-secret-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Automated Database Initialization
RUN_MIGRATIONS=true
RUN_SEED=true

# Frontend Nginx Configuration
FRONTEND_PORT=80
# Leave VITE_API_URL empty when using Nginx reverse proxy (Docker Compose),
# or specify public backend URL for split deployments (e.g. https://api.uberlite.example.com)
VITE_API_URL=
